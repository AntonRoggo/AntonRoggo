   "keep_start": true,
   "note": "Day in the life of an oyster farmer, part two. It's sunrise, so we're walking past the dock and going straight out."
  },
  {
   "src": [
    20.75,
    25.6
   ],
   "note": "This morning's low tide, so we take out the boat and you could walk the entire farm. (2nd take)"
  },
  {
   "src": [
    38.45,
    41.25
   ],
   "hold": 0.25,
   "note": "We haul the cages by hand and open them up... (beat)"
  },
  {
   "src": [
    43.0,
    44.9
   ],
   "note": "This one came with a little crab."
  },
  {
   "src": [
    46.07,
    49.95
   ],
   "note": "Every cage is a little reef. There's crabs, shrimps, baby fish."
  },
  {
   "src": [
    52.17,
    56.95
   ],
   "note": "But we're here for the oysters. Only the big ones go in the basket. The rest are left to grow."
  },
  {
   "src": [
    59.73,
    63.1
   ],
   "note": "We pass them up to the boat and we need to take them home ASAP."
  },
  {
   "src": [
    74.95,
    77.9
   ],
   "note": "But before we go, let's have the world's freshest oyster. (3rd take)"
  },
  {
   "src": [
    88.4,
    92.75
   ],
   "note": "We've got thousands of oysters up on the dock. We're gonna put them straight in the refrigerator."
  },
